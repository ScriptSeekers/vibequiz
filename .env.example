# ==========================================
# VIBE QUIZ - ENVIRONMENT CONFIGURATION
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend Services (Supabase Auth & Database Readiness)
# Replace with your project credentials when connecting live services
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# AI Service (FastAPI / OpenAI integration)
# Backend-only secrets — never prefix with NEXT_PUBLIC_
OPENAI_API_KEY=your-openai-api-key-here
AI_SERVICE_ENDPOINT=http://localhost:8000/api/v1
